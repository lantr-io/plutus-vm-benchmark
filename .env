# Pinned git SHAs for reproducibility
# Update these to benchmark different versions.
# Each images/<dir>/Dockerfile declares the ARGs it uses; scripts/images.sh passes
# only those as build args and hashes their values into the image tag.

UPLC_TURBO_REPO=https://github.com/pragma-org/uplc.git
UPLC_TURBO_SHA=0d6d2a4e4e66dcaa743ee5f59c88e02008cd5687 # amaru-uplc-v0.4.0 (2026-05-31)

PLUTIGO_REPO=https://github.com/blinklabs-io/plutigo.git
PLUTIGO_SHA=fcb4c036dd128837985a97ad0970dbc03f31497c # v0.1.10

BLAZE_REPO=https://github.com/butaneprotocol/blaze-cardano.git
BLAZE_SHA=0499975bfa4fdb324f2185657a7f17e4cea35aa1 # @blaze-cardano/vm@0.3.3 (2026-10-14); the benchmarked package is @blaze-cardano/plutus 0.1.1, released from this commit

HASKELL_REPO=https://github.com/IntersectMBO/plutus.git
HASKELL_SHA=507cab8cf6192e5143f12be5b2d3005a2928dc6d # release 1.70.0.0, the plutus-core of the latest cardano-node release (11.1.3, 2026-09-29)
HASKELL_GHC_VERSION=9.6.7

# Native Lean CEK runner: development benchmark/FFI/performance stack; pending a stable release.
PLUTUSCORE_LEAN_REPO=https://github.com/input-output-hk/PlutusCoreBlaster.git
PLUTUSCORE_LEAN_SHA=6a2bdd06126ccb67acf3441f43872935640c07e2 # development, native decoder/CEK performance stack; no release
PLUTUSCORE_LEAN_VERSION=4.24.0
PLUTUSCORE_BLASTER_SHA=c79efca704f5f1b7905a02f482197d259a166c4e

SCALUS_REPO=https://github.com/scalus3/scalus.git
SCALUS_SHA=985e8341247cfa40c6326a8167ab4c9876104f8b # v1.4.1 (2026-10-26)
# Maven version of the Scalus core and JIT (org.scalus::scalus, ::scalus-uplc-jit-compiler) for
# images/scalus; must be the release at SCALUS_SHA
SCALUS_VERSION=1.4.1

# Toolchain versions
RUST_VERSION=1.94
GO_VERSION=1.26
BUN_VERSION=1.3.10
# One Node.js for every JS row (images/node-base): Node 24 LTS "Krypton", the official image
# node:<NODE_VERSION>-bookworm-slim at NODE_IMAGE_DIGEST (the multi-platform index)
NODE_VERSION=24.22.1 # 2026-10-20
NODE_IMAGE_DIGEST=sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
PYTHON_VERSION=3.14
GHC_VERSION=9.6.4
JDK_VERSION=21
# Oracle GraalVM of the benchmark JVM of scalus-cek and scalus-jit (images/scalus/Dockerfile)
GRAALVM_VERSION=25.4.4 # GraalVM 25.4 for JDK 25.0.4, SDKMAN 25.4.4+1-graal
SBT_VERSION=1.10.11
# JMH of every JMH row (scalus-cek, scalus-jit, julc-java): sbt-jmh and the julc pom take this version
JMH_VERSION=1.37

# --- aiken (images/aiken) ---
AIKEN_REPO=https://github.com/aiken-lang/aiken.git
AIKEN_SHA=bacbeb35fbc9f1db93cd2e1e93fb1d93053acb4a # v1.1.24

# --- aiken-wasm (images/aiken-wasm) ---
# The published npm package, used as it is (spec D17). 0.4.0 is built from colll78/aiken@28e42883
# (aiken main after v1.1.24 plus PV11/PV12 fixes), not from AIKEN_SHA.
LUCID_UPLC_VERSION=0.4.0 # npm release 2026-10-16

# scalus-js image (images/scalus-js): the scalus npm package, and the vitest of the blaze-v8 harness
SCALUS_JS_VERSION=1.4.1
VITEST_VERSION=4.1.10

# --- experimental VMs (spec D22): newest pre-release tag, else a main commit ---
# julc-java (images/julc): the Maven Central artifact org.julclang:julc-vm-java
JULC_VERSION=0.1.0-pre19 # v0.1.0-pre19 = ed3f584886bb8f1f3ea4ada8784efcc1fa363a31 (2026-10-21), org.julclang:julc-vm-java on Maven Central

# chrysalis, chrysalis-aot (images/chrysalis): NuGet Chrysalis.Plutus; must be the release at CHRYSALIS_SHA
CHRYSALIS_REPO=https://github.com/SAIB-Inc/Chrysalis.git
CHRYSALIS_SHA=7c45d47c87c63520cea84212dbd01ecc8d372ac3 # v1.7.14-alpha (2026-06-29), = main
CHRYSALIS_VERSION=1.7.14-alpha
DOTNET_VERSION=10.0

# plutuz (images/plutuz)
PLUTUZ_REPO=https://github.com/utxo-company/plutuz.git
PLUTUZ_SHA=33b812dbcf88f6851286e54cb93a4a443353f94c # main (2026-03-07), no tags or releases
ZIG_VERSION=0.15.2 # minimum_zig_version of plutuz build.zig.zon

# uplc-turbo-bc (images/uplc-turbo-bc): the bytecode mode exists only in a fork (closed PR pragma-org/uplc#47)
UPLC_TURBO_BC_REPO=https://github.com/jonathanlim222/uplc.git
UPLC_TURBO_BC_SHA=069cef5684d57064d040ab498a5d2eac01e63275 # jonathanlim222/uplc main = pi/bytecode (2026-04-30), closed PR pragma-org/uplc#47

# llvm-uplc-jit (images/llvm-uplc): experimental, badge "outdated cost model" (spec D22)
LLVM_UPLC_REPO=https://github.com/SeungheonOh/llvm-uplc.git
LLVM_UPLC_SHA=6bcef67ce1995d232327f13d9080fe2f0261a55c # main (2026-04-16), no tags or releases
LLVM_VERSION=22 # apt.llvm.org major; llvm-uplc needs >= 19
